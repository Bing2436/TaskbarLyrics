<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarLyrics</AssemblyName>
    <RootNamespace>TaskbarLyrics</RootNamespace>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\TaskbarLyrics.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LyricsProbe\**\*.cs" />
    <None Remove="LyricsProbe\**\*" />
  </ItemGroup>
</Project>
